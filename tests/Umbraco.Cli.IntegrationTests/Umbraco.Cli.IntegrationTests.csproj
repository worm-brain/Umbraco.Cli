<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Dynamic per-test skip (Skip.IfNot) so tests are skipped, not failed, when no live
         Umbraco instance is reachable - keeps solution-wide `dotnet test` green in CI. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the CLI so it builds before these tests; the harness invokes its built
         Umbraco.Cli.dll as a subprocess (located at runtime). -->
    <ProjectReference Include="..\..\src\Umbraco.Cli\Umbraco.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Text.Json" />
  </ItemGroup>
</Project>
