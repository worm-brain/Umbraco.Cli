<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Dynamic per-test skip (Skip.IfNot) so tests are skipped, not failed, when no live
         Umbraco instance is reachable - keeps solution-wide `dotnet test` green in CI. -->
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the CLI so it builds before these tests; the harness invokes its built
         Umbraco.Community.Cli.dll as a subprocess (located at runtime). -->
    <ProjectReference Include="..\..\src\Umbraco.Community.Cli\Umbraco.Community.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Text.Json" />
  </ItemGroup>
</Project>
