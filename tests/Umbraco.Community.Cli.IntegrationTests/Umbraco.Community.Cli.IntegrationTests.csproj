<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- An xUnit v3 test project is its own Microsoft.Testing.Platform executable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the CLI so it builds before these tests; the harness invokes its built
         Umbraco.Community.Cli.dll as a subprocess (located at runtime). -->
    <ProjectReference Include="..\..\src\Umbraco.Community.Cli\Umbraco.Community.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Text.Json" />
  </ItemGroup>
</Project>
