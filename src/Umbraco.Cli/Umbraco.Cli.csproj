<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Global Tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>umbraco</ToolCommandName>
    <PackageId>Umbraco.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>worm-brain</Authors>
    <Description>Cross-platform CLI for Umbraco CMS. Manage content, media, users and more from the terminal or any AI agent.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/worm-brain/Umbraco.Cli</RepositoryUrl>
    <PackageTags>umbraco;cms;cli;tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Cli.Client\Umbraco.Cli.Client.csproj" />
  </ItemGroup>

</Project>
