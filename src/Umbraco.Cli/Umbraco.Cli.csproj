<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Global Tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>umbraco</ToolCommandName>
    <!-- NuGet package ID. The `Umbraco.*` prefix is a reserved namespace owned by
         Umbraco A/S, so third-party tools cannot publish under it. HQ opened up the
         `Umbraco.Community.*` sub-prefix as a shared namespace for community packages,
         which is the sanctioned convention we follow here. The CLI command itself
         (ToolCommandName) stays `umbraco`, and the repo / assembly names stay Umbraco.Cli. -->
    <PackageId>Umbraco.Community.Cli</PackageId>
    <!-- Base version used for local `dotnet pack`. The release workflow overrides
         this with the full version (incl. prerelease suffix) taken from the git tag,
         e.g. `-p:Version=0.1.0-alpha.1`, so tag and package version never drift. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>worm-brain</Authors>
    <Company>worm-brain</Company>
    <Copyright>Copyright © 2026 worm-brain</Copyright>
    <Description>Cross-platform CLI for Umbraco CMS. Manage content, media, document types, languages, members, users, dictionary items and webhooks from the terminal or any AI agent that can invoke a subprocess. Produces structured JSON output by default when stdout is piped.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/worm-brain/Umbraco.Cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/worm-brain/Umbraco.Cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;cms;cli;dotnet-tool;ai;management-api;content-management</PackageTags>
    <PackageReleaseNotes>Alpha preview. Full coverage of the Umbraco 17+ Management API; not yet production-tested. APIs and behaviour may change before 1.0.0.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Cli.Client\Umbraco.Cli.Client.csproj" />
  </ItemGroup>

  <!-- The JSON Schemas of the raw schema verbs' request bodies, generated from spec/management.json
       by ApiBodySchemaTests and embedded so printing a schema needs no host. -->
  <ItemGroup>
    <EmbeddedResource
      Include="Schemas\api-bodies.json"
      LogicalName="Umbraco.Cli.Schemas.api-bodies.json"
    />
  </ItemGroup>

  <!-- Expose internal helpers (e.g. PasswordGenerator) to the unit test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageReference Include="Spectre.Console" Version="0.57.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <!-- DPAPI for encrypting the stored client secret at rest on Windows (issue #45).
         The API is Windows-only at runtime; calls are guarded by OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
</Project>
