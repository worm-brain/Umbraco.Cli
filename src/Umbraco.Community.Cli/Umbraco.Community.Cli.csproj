<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- NuGet Global Tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>umbraco</ToolCommandName>
    <!-- NuGet package ID. The `Umbraco.*` prefix is a reserved namespace owned by
         Umbraco A/S, so third-party tools cannot publish under it. HQ opened up the
         `Umbraco.Community.*` sub-prefix as a shared namespace for community packages,
         which is the sanctioned convention we follow here. The assembly and namespaces
         share the package ID; the CLI command itself (ToolCommandName) stays `umbraco`. -->
    <PackageId>Umbraco.Community.Cli</PackageId>
    <!-- Base version used for local `dotnet pack`. The release workflow overrides
         this with the full version (incl. prerelease suffix) taken from the git tag,
         e.g. `-p:Version=0.1.0-alpha.1`, so tag and package version never drift. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>worm-brain</Authors>
    <Company>worm-brain</Company>
    <Copyright>Copyright © 2026 worm-brain</Copyright>
    <Description>A command-line tool for Umbraco CMS 17+. Manage content, media, document types and more from a terminal, a script or a CI pipeline, and move schema, media and content between sites. Every command can print JSON or CSV.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- nuget.org needs a PNG or JPEG icon (no SVG); 128x128 is its recommended size. -->
    <PackageIcon>umbraco-cli-128.png</PackageIcon>
    <PackageProjectUrl>https://github.com/worm-brain/Umbraco.Cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/worm-brain/Umbraco.Cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;cms;cli;dotnet-tool;ai;management-api;content-management</PackageTags>
    <PackageReleaseNotes>Release candidate. Commands and output may still change before 1.0.0.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- nuget.org renders no raw HTML and no relative links or images, and a published readme
         can't be fixed without a release, so the package carries its own short readme with
         absolute links rather than the GitHub README. -->
    <None Include="README.nuget.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\assets\umbraco-cli-128.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.Cli.Client\Umbraco.Community.Cli.Client.csproj" />
  </ItemGroup>

  <!-- The JSON Schemas of the raw schema verbs' request bodies, generated from spec/management.json
       by ApiBodySchemaTests and embedded so printing a schema needs no host. -->
  <ItemGroup>
    <EmbeddedResource
      Include="Schemas\api-bodies.json"
      LogicalName="Umbraco.Community.Cli.Schemas.api-bodies.json"
    />
  </ItemGroup>

  <!-- Expose internal helpers (e.g. PasswordGenerator) to the unit test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <!-- DPAPI for encrypting the stored client secret at rest on Windows (issue #45).
         The API is Windows-only at runtime; calls are guarded by OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
</Project>
